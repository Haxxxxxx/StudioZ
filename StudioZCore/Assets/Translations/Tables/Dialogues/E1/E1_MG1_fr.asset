  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: E1_MG1_fr
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 0108a1c01abc12d4da0c39f137ee51bb, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 114874609664
    m_Localized: "C\u2019est ici que tout commence\u2026 L\xE0 o\xF9 j\u2019ai pris
      racine il me semble. Mais\u2026 quelque chose a chang\xE9. Les terres souffrent,
      il faut remedier a ca, aide nous Lyra."
    m_Metadata:
      m_Items: []
  - m_Id: 839126052864
    m_Localized: "On dirait que la nature a \xE9t\xE9 maltrait\xE9e\u2026 Mais il
      y a encore de l\u2019espoir. Si on plante les bonnes graines, tout peut rena\xEEtre."
    m_Metadata:
      m_Items: []
  - m_Id: 902770421760
    m_Localized: "Allons-y ! \xC0 nous de redonner vie \xE0 ce champ. Mais attention,
      Profane n\u2019est s\xFBrement pas tr\xE8s loin."
    m_Metadata:
      m_Items: []
  - m_Id: 14066477436776448
    m_Localized: "Regarde ce grand sac plein de graines ! Tu vois, toutes ne sont
      pas bonnes pour faire pousser du coton. Suis moi je te montre ! \r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 14066808396722176
    m_Localized: 'Alors, on a trois sortes de graines ici :'
    m_Metadata:
      m_Items: []
  - m_Id: 14066912096694272
    m_Localized: "Les graines toutes rondes, bien claires ? Ce sont les graines saines
      ! Ce sont elles qu\u2019on veut planter."
    m_Metadata:
      m_Items: []
  - m_Id: 14067144435970048
    m_Localized: "Les graines toutes bizarres et violettes ? Oups\u2026 celles-l\xE0
      ont \xE9t\xE9 corrompues par Profane. Si tu les plantes, elles ralentissent
      la pousse du coton.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 14067320626098176
    m_Localized: "Celles qui ressemblent \xE0 des bouts d\u2019\xE9corce ou du ma\xEFs
      ? Elles sont inutiles. Elles ne feront pousser que du vent !"
    m_Metadata:
      m_Items: []
  - m_Id: 14067510607097856
    m_Localized: "\xC0 toi de jouer maintenant  ! Attrape les graines saines et mets
      les dans le sac. Si tu te trompes, pas de panique, on peut toujours recommencer
      !"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
